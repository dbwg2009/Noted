# Postgres
# - Local Docker stack: leave unset; docker-compose.yml provides this
# - Neon (production): postgres://USER:PASSWORD@HOST/DB?sslmode=require
# - Local non-docker: postgres://USER:PASSWORD@localhost:5432/birthday
DATABASE_URL=

# Auth.js
AUTH_SECRET=replace_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Resend (used for both magic-link auth and birthday reminder emails)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Birthday Gift Finder <onboarding@resend.dev>"

# The single allowed sign-in email (single-user mode)
ALLOWED_EMAIL=you@example.com

# OpenRouter (LLM provider — get a free key at https://openrouter.ai/)
OPENROUTER_API_KEY=sk-or-v1-...
# Free model default. Override to try other free models from openrouter.ai/models
# (filter by "Pricing: Free"). Examples: deepseek/deepseek-chat-v3.1:free,
# qwen/qwen-2.5-72b-instruct:free, google/gemma-2-9b-it:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional: shown in OpenRouter rankings (any URL works locally)
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=Birthday Gift Finder

# eBay Browse API (free) - optional fallback for product search
EBAY_APP_ID=

# Postgres (Neon connection string with sslmode=require)
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Auth.js
AUTH_SECRET=replace_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Resend (used for both magic-link auth and birthday reminder emails)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Birthday Gift Finder <onboarding@resend.dev>"

# The single allowed sign-in email (single-user mode)
ALLOWED_EMAIL=you@example.com

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# eBay Browse API (free) - optional fallback for product search
EBAY_APP_ID=
